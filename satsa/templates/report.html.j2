<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="utf-8">
<title>SAT-SA Supervisory Assessment Report {{ report.run_id }}</title>
<style>
  @page { size: A4; margin: 18mm 14mm; }
  body { font-family: Georgia, "Times New Roman", serif; color: #0F172A; font-size: 11px; line-height: 1.45; margin: 0; }
  h1 { font-size: 22px; margin: 0 0 2px 0; color: #1E3A8A; letter-spacing: .5px; }
  h2 { font-size: 14px; margin: 22px 0 8px 0; color: #1E3A8A; border-bottom: 2px solid #1E3A8A; padding-bottom: 3px; }
  .subtitle { color: #475569; font-size: 11px; margin-bottom: 4px; }
  .badge { display: inline-block; background: #1E3A8A; color: #fff; padding: 2px 8px; border-radius: 3px; font-size: 9px; font-weight: bold; }
  .badge.warn { background: #B91C1C; }
  .kpis { display: flex; gap: 10px; margin: 14px 0; }
  .kpi { flex: 1; border: 1px solid #CBD5E1; border-radius: 6px; padding: 8px 10px; background: #F8FAFC; }
  .kpi .v { font-size: 20px; font-weight: bold; color: #1E3A8A; }
  .kpi .l { font-size: 9px; color: #475569; text-transform: uppercase; letter-spacing: .4px; }
  table { width: 100%; border-collapse: collapse; margin: 6px 0 12px 0; font-size: 10px; }
  th { background: #1E3A8A; color: #fff; text-align: left; padding: 5px 6px; font-weight: 600; }
  td { border-bottom: 1px solid #E2E8F0; padding: 4px 6px; vertical-align: top; }
  tr:nth-child(even) td { background: #F8FAFC; }
  .tier-critical, .tier-high { color: #B91C1C; font-weight: bold; }
  .tier-elevated { color: #D97706; font-weight: bold; }
  .tier-moderate { color: #2563EB; }
  .tier-low { color: #16A34A; }
  .verdict-substantiated { color: #16A34A; font-weight: bold; }
  .verdict-partially_substantiated { color: #D97706; font-weight: bold; }
  .verdict-materially_exaggerated { color: #B91C1C; font-weight: bold; }
  .footer { margin-top: 26px; padding-top: 8px; border-top: 1px solid #CBD5E1; font-size: 9px; color: #64748B; }
  .note { background: #EFF6FF; border-left: 4px solid #2563EB; padding: 6px 10px; font-size: 10px; margin: 8px 0; }
  .mono { font-family: "Courier New", monospace; font-size: 9px; }
</style>
</head>
<body>

<h1>SAT-SA Supervisory Assessment Report</h1>
<div class="subtitle">Supervisory Analytics Tool for SOC Assessment &mdash; NCIIPC PS26157 &mdash; offline, air-gapped execution</div>
<div class="subtitle">
  Run <span class="mono">{{ report.run_id }}</span> &middot;
  Generated {{ report.generated_at }} &middot;
  Manifest <span class="mono">{{ report.manifest_hash }}</span>
  {% if report.audit_valid %}<span class="badge">AUDIT CHAIN INTACT</span>{% else %}<span class="badge warn">AUDIT TAMPER DETECTED</span>{% endif %}
</div>

<div class="kpis">
  <div class="kpi"><div class="v">{{ report.entity_count }}</div><div class="l">CSE Entities</div></div>
  <div class="kpi"><div class="v">{{ report.total_findings }}</div><div class="l">Supervisory Findings</div></div>
  <div class="kpi"><div class="v">{{ report.high_risk_count }}</div><div class="l">High/Critical Entities</div></div>
  <div class="kpi"><div class="v">{{ report.queue_total }}</div><div class="l">Queued for Review</div></div>
  <div class="kpi"><div class="v">{{ report.claim_summary.mean_index if report.claim_summary.mean_index is not none else "n/a" }}</div><div class="l">Mean Claim Index</div></div>
</div>

<h2>1. Portfolio Risk Ranking</h2>
<table>
  <tr><th>#</th><th>Entity</th><th>Risk Index</th><th>Tier</th><th>Peer Pct</th><th>QoQ</th><th>Findings</th></tr>
  {% for e in report.entities %}
  <tr>
    <td>{{ loop.index }}</td>
    <td class="mono">{{ e.entity_id }}</td>
    <td>{{ "%.1f"|format(e.risk_index) }}</td>
    <td class="tier-{{ e.tier }}">{{ e.tier|upper }}</td>
    <td>{{ "%.1f"|format(e.percentile) }}%</td>
    <td>{{ e.trend }}</td>
    <td>{{ e.findings_count }}</td>
  </tr>
  {% endfor %}
</table>

<h2>2. Findings by Concept Lane</h2>
<table>
  <tr><th>Concept</th><th>Findings</th><th>Share</th></tr>
  {% for c in report.concept_rows %}
  <tr><td>{{ c.concept }}</td><td>{{ c.count }}</td><td>{{ "%.1f"|format(c.share) }}%</td></tr>
  {% endfor %}
</table>

<h2>3. Top Detectors by Volume</h2>
<table>
  <tr><th>Detector</th><th>Findings</th></tr>
  {% for d in report.detector_counts %}
  <tr><td class="mono">{{ d.detector_id }}</td><td>{{ d.count }}</td></tr>
  {% endfor %}
</table>

<h2>4. Claim-vs-Reality Index</h2>
{% if report.claim_entities %}
<div class="note">
  Self-reported entity KPIs (close time, coverage, false-positive rate, escalation rate)
  compared against audited records.
  {% if report.claim_summary.materially_exaggerated %}
  <strong>{{ report.claim_summary.materially_exaggerated|length }} entities materially exaggerate their claims:</strong>
  <span class="mono">{{ report.claim_summary.materially_exaggerated|join(", ") }}</span>.
  {% endif %}
</div>
<table>
  <tr><th>Entity</th><th>Index</th><th>Verdict</th><th>Metrics Claimed</th><th>Exaggerated</th></tr>
  {% for c in report.claim_entities %}
  <tr>
    <td class="mono">{{ c.entity_id }}</td>
    <td>{{ "%.1f"|format(c.index) }}</td>
    <td class="verdict-{{ c.verdict }}">{{ c.verdict.replace("_", " ") }}</td>
    <td>{{ c.n_claimed }}</td>
    <td>{{ c.exaggerated_count }}</td>
  </tr>
  {% endfor %}
</table>
{% else %}
<p>No self-reported KPI claims were submitted for this reporting period.</p>
{% endif %}

<h2>5. Highest-Priority Findings for Examiner Review</h2>
<table>
  <tr><th>Finding</th><th>Entity</th><th>Detector</th><th>Scope</th><th>Sev</th><th>Reason</th></tr>
  {% for f in report.top_findings %}
  <tr>
    <td class="mono">{{ f.finding_id }}</td>
    <td class="mono">{{ f.entity_id }}</td>
    <td class="mono">{{ f.detector_id }}</td>
    <td class="mono">{{ f.scope }}</td>
    <td>{{ "%.1f"|format(f.severity_weight) }}</td>
    <td>{{ f.reason_text }}</td>
  </tr>
  {% endfor %}
</table>

<div class="footer">
  SAT-SA v{{ report.version }} &middot; Generated entirely offline (no network calls) &middot;
  Source artifacts: findings.json, entity_scores.json, review_queue.json, claim_reality.json, audit_log.jsonl &middot;
  Hash-chained audit verification: {{ "PASS" if report.audit_valid else "FAIL" }}
</div>

</body>
</html>
